  "transformation_protocols": {
    "zscore": {
      "formula": "x_norm = (x - mean) / std",
      "description": "Standard zero-mean unit-variance transformation using train statistics."
    },
    "minmax": {
      "formula": "x_scaled = (x - min) / (max - min)",
      "description": "Bounded [0, 1] normalization preserving physical zero floor."
    },
    "rainfall_physics_m_s": {
      "formula": "R_m_s = R_mm_5min / (1000.0 * 300.0)",
      "description": "Conversion from mm per 5-minute interval to SI mass flux rate m/s."
    },
    "building_mask": {
      "formula": "mask = isnan(dem) | (dem >= wall_threshold)",
      "description": "Binary mask (1 = building/boundary barrier, 0 = active hydraulic conveyance surface). Rainfall forced to 0 on building cells."
    }
  }
